# Each block below is complete for one service: copy a whole block into that
# service's production environment. Keys shared by services are repeated on
# purpose; keep the repeated values identical.

# -------------------- api --------------------
# API: apps/api (also serves the web console)
DATABASE_URL=postgresql://deepvue:deepvue@postgres:5432/deepvue
LOG_LEVEL=info
PORT=3000
# prod: long random secret, sent as X-Admin-Key
ADMIN_KEY=dv_admin_local_only_change_me
APPLICATION_DEADLINE_MS=60000
# prod: public URL of the mock-upstream service
UPSTREAM_BASE_URL=http://mock-upstream:4000
# prod: public URL of the worker service (probed by /v1/keepalive)
WORKER_BASE_URL=http://worker:4100
# Gemini key pool, comma separated LABEL__SPLIT__KEY entries (a bare key also works)
GEMINI_API_KEYS=
MODEL_NAME=gemini-2.5-flash
MODEL_OUTAGE=false
KAVERI_ACTIVE_POLICY_VERSION=3.1
NEXA_ACTIVE_POLICY_VERSION=1.4

# -------------------- worker --------------------
# Worker: apps/worker
DATABASE_URL=postgresql://deepvue:deepvue@postgres:5432/deepvue
LOG_LEVEL=info
WORKER_PORT=4100
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=5
APPLICATION_DEADLINE_MS=60000
WATCHDOG_INTERVAL_MS=10000
WATCHDOG_STALE_MS=120000
WORKER_MAX_ATTEMPTS=3
# prod: public URL of the mock-upstream service
UPSTREAM_BASE_URL=http://mock-upstream:4000
UPSTREAM_TIMEOUT_MS=4000
UPSTREAM_MAX_ATTEMPTS=3
UPSTREAM_BACKOFF_BASE_MS=500
UPSTREAM_TOTAL_BUDGET_MS=20000
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_MS=30000
# Gemini key pool, comma separated LABEL__SPLIT__KEY entries (a bare key also works)
GEMINI_API_KEYS=
MODEL_NAME=gemini-2.5-flash
MODEL_THINKING_BUDGET=0
MODEL_TIMEOUT_MS=15000
MODEL_MAX_ATTEMPTS=2
MODEL_OUTAGE=false
MODEL_RPM_LIMIT=8
MODEL_QUEUE_MAX_WAIT_MS=20000
EXTRACTION_CACHE_ENABLED=true

# -------------------- mock-upstream --------------------
# Mock registry: apps/mock-upstream
MOCK_PORT=4000
MOCK_FAIL_RATE=0.30
MOCK_HANG_RATE=0.10
MOCK_RATE_LIMIT_RATE=0.05
MOCK_HANG_SECONDS=25
# prod: long random secret, sent as X-Admin-Key to the mock
MOCK_ADMIN_KEY=dv_admin_local_only_change_me
