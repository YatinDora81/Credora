# ---- shared ----
DATABASE_URL=postgresql://deepvue:deepvue@postgres:5432/deepvue
LOG_LEVEL=info

# ---- api ----
PORT=3000
ADMIN_KEY=dv_admin_local_only_change_me

# ---- worker ----
WORKER_POLL_INTERVAL_MS=1000
WORKER_BATCH_SIZE=5
APPLICATION_DEADLINE_MS=60000
WATCHDOG_INTERVAL_MS=10000
WATCHDOG_STALE_MS=120000
WORKER_MAX_ATTEMPTS=3
WORKER_PORT=4100                     # worker's GET /health listener
# Where the API reaches the worker's /health for /v1/keepalive. On a host that sleeps
# idle services, set this (and UPSTREAM_BASE_URL) to the public URL so pings count as traffic.
WORKER_BASE_URL=http://worker:4100

# ---- upstream client ----
UPSTREAM_BASE_URL=http://mock-upstream:4000
UPSTREAM_TIMEOUT_MS=4000
UPSTREAM_MAX_ATTEMPTS=3
UPSTREAM_BACKOFF_BASE_MS=500
UPSTREAM_TOTAL_BUDGET_MS=20000
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_MS=30000

# ---- model ----
# Single key. Leave blank to run with the extractor permanently unavailable.
GEMINI_API_KEY=
# Optional: rotated key pool. Comma separated, each entry "LABEL__SPLIT__KEY".
# When set, this takes precedence over GEMINI_API_KEY and the RPM ceiling below
# is applied PER KEY, so N keys give N x MODEL_RPM_LIMIT effective throughput.
GEMINI_API_KEYS=
MODEL_NAME=gemini-2.5-flash
# gemini-2.5-flash bills thinking tokens against maxOutputTokens and they cost
# ~10s per extraction. Extraction is pure transcription, so 0 is correct here.
MODEL_THINKING_BUDGET=0
MODEL_TIMEOUT_MS=15000
MODEL_MAX_ATTEMPTS=2
MODEL_OUTAGE=false          # <- assessor flips this
MODEL_RPM_LIMIT=8           # stay under the free-tier ceiling
MODEL_QUEUE_MAX_WAIT_MS=20000
EXTRACTION_CACHE_ENABLED=true

# ---- policy pinning ----
KAVERI_ACTIVE_POLICY_VERSION=3.1     # <- assessor flips this to 3.2
NEXA_ACTIVE_POLICY_VERSION=1.4

# ---- mock upstream ----
MOCK_PORT=4000
MOCK_FAIL_RATE=0.30         # 5xx or connection reset
MOCK_HANG_RATE=0.10         # no response for >= 20s
MOCK_RATE_LIMIT_RATE=0.05   # 429 with Retry-After: 5
MOCK_HANG_SECONDS=25
MOCK_ADMIN_KEY=dv_admin_local_only_change_me
