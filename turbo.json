{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build":   { "dependsOn": ["^build", "db:generate"], "outputs": ["dist/**"] },
    "test":    { "dependsOn": ["^build"], "outputs": [] },
    "dev":     { "cache": false, "persistent": true },
    "db:generate": { "cache": false, "outputs": ["../../node_modules/.prisma/**"] }
  }
}
